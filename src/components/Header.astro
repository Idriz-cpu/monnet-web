---
import { nav } from '../data/site';
---
<header class="sticky top-0 z-40 bg-white/90 backdrop-blur border-b border-slate-200">
  <div class="mx-auto max-w-7xl px-4 flex h-16 items-center justify-between gap-4">
    <a href="/" class="font-extrabold text-xl tracking-tight text-brand-900">MON<span class="text-brand-500">-NET</span></a>
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
      {nav.map((n) => <a href={n.href} class="hover:text-brand-600">{n.label}</a>)}
      <a href="/fr/" class="text-slate-500 hover:text-brand-600">FR</a>
      <a href="/preisanfrage/" class="rounded-full bg-accent-400 px-4 py-2 font-semibold text-brand-900 hover:bg-accent-500">Wärmepumpe konfigurieren</a>
    </nav>
    <details class="md:hidden relative">
      <summary class="list-none cursor-pointer p-2 text-2xl" aria-label="Menü">☰</summary>
      <div class="absolute right-0 mt-2 w-56 rounded-xl border bg-white p-3 shadow-lg flex flex-col gap-2">
        {nav.map((n) => <a href={n.href} class="py-1">{n.label}</a>)}
        <a href="/preisanfrage/" class="rounded-full bg-accent-400 px-4 py-2 text-center font-semibold text-brand-900">Wärmepumpe konfigurieren</a>
      </div>
    </details>
  </div>
</header>
