---
import Layout from '../../layouts/Layout.astro';
import wp from '../../data/waermepumpe.json';
const sel = 'mt-1 w-full rounded-lg border border-slate-300 bg-white p-2.5';
const card = 'cursor-pointer rounded-xl border-2 border-slate-200 p-5 transition hover:border-brand-500 has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50';
---
<Layout title="Wärmepumpen-Konfigurator Luxemburg" description="Konfigurieren Sie Ihre Wärmepumpe in 2 Minuten: Festpreis inkl. Montage, Klimabonus und Eigenanteil für Luxemburg.">
  <section class="bg-brand-900 text-white">
    <div class="mx-auto max-w-3xl px-4 pt-12 pb-16 text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent-400">Luxemburg · Komplettmontage durch MON-NET</p>
      <h1 class="mt-2 text-3xl font-extrabold md:text-4xl">Wärmepumpen-Konfigurator</h1>
      <p class="mt-3 text-brand-100">Drei kurze Fragen, dann sehen Sie Ihr passendes Paket mit Preis, Klimabonus und Eigenanteil.</p>
    </div>
  </section>

  <section class="mx-auto -mt-8 max-w-3xl px-4 pb-16">
    <form id="qf" name="preisanfrage" method="POST" action="/api/anfrage.php" class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xl md:p-10">
      <input type="hidden" name="form-name" value="preisanfrage" />
      <input type="hidden" name="ergebnis" id="ergebnis" />
      <p class="hidden"><label>Nicht ausfüllen: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

      <div class="mb-8">
        <div class="flex justify-between text-xs font-medium text-slate-500"><span>Vorhaben</span><span>Haus</span><span>Wärme</span><span>Ihr Paket</span></div>
        <div class="mt-2 h-2 rounded-full bg-slate-100"><div id="bar" class="h-2 rounded-full bg-accent-400 transition-all duration-500" style="width:25%"></div></div>
      </div>

      <fieldset data-step="1">
        <legend class="text-xl font-bold text-brand-900">Was haben Sie vor?</legend>
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          <label class={card}><input type="radio" name="vorhaben" value="modernisieren" class="sr-only" required />
            <div class="text-3xl">🔧</div><div class="mt-2 font-semibold">Heizung modernisieren</div><div class="text-sm text-slate-500">Öl, Gas oder Strom durch eine Wärmepumpe ersetzen</div></label>
          <label class={card}><input type="radio" name="vorhaben" value="neubau" class="sr-only" />
            <div class="text-3xl">🏡</div><div class="mt-2 font-semibold">Neubau planen</div><div class="text-sm text-slate-500">Wärmepumpe für ein neues Haus</div></label>
        </div>
      </fieldset>

      <fieldset data-step="2" class="hidden space-y-5">
        <legend class="text-xl font-bold text-brand-900">Ihr Haus</legend>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block" data-only="modernisieren">Wie heizen Sie aktuell?
            <select name="heizung" class={sel}><option value="oel">Öl</option><option value="gas">Gas</option><option value="strom">Strom / Nachtspeicher</option><option value="andere">Andere</option></select>
          </label>
          <label class="block">Beheizte Wohnfläche (m²)
            <input type="number" name="flaeche" min="40" max="600" required placeholder="z. B. 160" class={sel} />
          </label>
          <label class="block" data-only="modernisieren">Dämmzustand
            <select name="daemmung" class={sel}>
              <option value="saniert">Gut gedämmt (saniert, neue Fenster)</option>
              <option value="teilsaniert" selected>Teilweise saniert</option>
              <option value="unsaniert">Unsaniert / Altbau</option>
            </select>
          </label>
          <label class="block">Postleitzahl
            <input name="plz" required inputmode="numeric" pattern="(L-?)?[0-9]{4}" placeholder="z. B. L-6690" class={sel} />
          </label>
        </div>
      </fieldset>

      <fieldset data-step="3" class="hidden space-y-5">
        <legend class="text-xl font-bold text-brand-900">Wärme und Warmwasser</legend>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block">Wie wird die Wärme verteilt?
            <select name="verteilung" class={sel}><option value="fussboden">Fußbodenheizung</option><option value="gemischt">Gemischt</option><option value="heizkoerper">Heizkörper</option></select>
          </label>
          <label class="block">Personen im Haushalt
            <input type="number" name="personen" min="1" max="12" value="3" required class={sel} />
          </label>
        </div>
        <label class="block">Wann möchten Sie umsetzen?
          <select name="zeitraum" class={sel}><option>So bald wie möglich</option><option>In 3–6 Monaten</option><option>In 6–12 Monaten</option><option>Nur informieren</option></select>
        </label>
      </fieldset>

      <fieldset data-step="4" class="hidden space-y-6">
        <legend class="sr-only">Ihr Ergebnis</legend>
        <div id="result" class="rounded-2xl border border-eco-500/30 bg-eco-500/10 p-6">
          <div class="text-sm font-semibold uppercase tracking-wide text-eco-500">Ihr empfohlenes Paket</div>
          <div id="r-name" class="mt-1 text-2xl font-extrabold text-brand-900"></div>
          <div id="r-load" class="text-sm text-slate-500"></div>
          <dl class="mt-5 space-y-2 text-base">
            <div class="flex justify-between gap-4"><dt>Festpreis inkl. Montage und MwSt.</dt><dd id="r-price" class="whitespace-nowrap font-semibold"></dd></div>
            <div class="flex justify-between gap-4 text-eco-500"><dt>Geschätzter Klimabonus</dt><dd id="r-bonus" class="whitespace-nowrap font-semibold"></dd></div>
            <div class="flex justify-between gap-4 border-t border-slate-300 pt-2 text-lg"><dt class="font-bold">Ihr Eigenanteil</dt><dd id="r-own" class="whitespace-nowrap font-extrabold text-brand-900"></dd></div>
          </dl>
          <p id="r-tripartite" class="mt-2 text-sm text-slate-600"></p>
          <ul class="mt-5 space-y-1 text-sm text-slate-700">{wp.imPaketEnthalten.map((t) => <li>✓ {t}</li>)}</ul>
          <p class="mt-4 text-xs text-slate-500">Unverbindlicher Richtpreis. {wp.foerderung.hinweis} Den verbindlichen Festpreis erhalten Sie nach einer kostenlosen Besichtigung vor Ort.</p>
        </div>
        <h2 class="text-xl font-bold text-brand-900">Festpreisangebot anfordern</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block">Vor- und Nachname<input name="name" required autocomplete="name" class={sel} /></label>
          <label class="block">Telefon<input type="tel" name="telefon" required autocomplete="tel" class={sel} /></label>
          <label class="block sm:col-span-2">E-Mail<input type="email" name="email" required autocomplete="email" class={sel} /></label>
        </div>
        <label class="block">Nachricht (optional)<textarea name="nachricht" rows="3" class={sel}></textarea></label>
        <label class="flex items-start gap-2 text-sm"><input type="checkbox" name="datenschutz" value="ja" required class="mt-1" /> <span>Ich bin einverstanden, dass MON-NET meine Angaben zur Bearbeitung der Anfrage speichert und mich kontaktiert (<a href="/datenschutz/" class="underline">Datenschutz</a>).</span></label>
      </fieldset>

      <div class="mt-8 flex justify-between">
        <button type="button" id="back" class="invisible rounded-full px-6 py-3 font-semibold text-slate-600 hover:bg-slate-100">← Zurück</button>
        <button type="button" id="next" class="rounded-full bg-brand-600 px-6 py-3 font-semibold text-white hover:bg-brand-700">Weiter →</button>
        <button type="submit" id="submit" class="hidden rounded-full bg-accent-400 px-6 py-3 font-semibold text-brand-900 hover:bg-accent-500">Angebot anfordern</button>
      </div>
    </form>
  </section>

  <script define:vars={{ wp }}>
    const f = document.getElementById('qf');
    const steps = [...f.querySelectorAll('[data-step]')];
    const $ = (id) => document.getElementById(id);
    const fmt = (n) => (Math.round(n / 100) * 100).toLocaleString('de-DE') + ' €';
    let cur = 0;

    const neubau = () => f.vorhaben.value === 'neubau';

    function applyVorhaben() {
      f.querySelectorAll('[data-only]').forEach((el) => el.classList.toggle('hidden', neubau()));
    }

    function calc() {
      const area = +f.flaeche.value;
      const zustand = neubau() ? 'neubau' : f.daemmung.value;
      const load = area * wp.wattProM2[zustand] / 1000 + (+f.personen.value) * wp.warmwasserKwProPerson;
      const pkg = wp.pakete.find((p) => p.kw >= load) || wp.pakete[wp.pakete.length - 1];
      const price = pkg.preis
        + (f.verteilung.value === 'heizkoerper' ? wp.aufpreisHeizkoerper : 0)
        + (neubau() ? 0 : wp.demontage[f.heizung.value] || 0);
      const bonus = neubau() ? wp.foerderung.klimabonusNeubau : wp.foerderung.klimabonusErsatz;
      const own = Math.max(0, price - bonus);
      $('r-name').textContent = pkg.name;
      $('r-load').textContent = `Geschätzte Heizlast ca. ${load.toLocaleString('de-DE', { maximumFractionDigits: 1 })} kW`;
      $('r-price').textContent = fmt(price);
      $('r-bonus').textContent = bonus ? '− ' + fmt(bonus) : 'im Neubau nach Prüfung';
      $('r-own').textContent = fmt(own);
      $('r-tripartite').textContent = !neubau() && wp.foerderung.klimabonusMitTripartite > bonus
        ? `Mit Tripartite-Zuschlag sind bis zu ${fmt(wp.foerderung.klimabonusMitTripartite)} Förderung möglich.` : '';
      $('result').classList.toggle('hidden', !wp.anzeigen);
      $('ergebnis').value = `${pkg.name}, Heizlast ca. ${load.toFixed(1)} kW, Preis ${Math.round(price)} EUR, Klimabonus ${bonus} EUR, Eigenanteil ${Math.round(own)} EUR`;
    }

    function show(i) {
      cur = i;
      steps.forEach((s, j) => s.classList.toggle('hidden', j !== i));
      $('bar').style.width = ((i + 1) / steps.length) * 100 + '%';
      $('back').classList.toggle('invisible', i === 0);
      $('next').classList.toggle('hidden', i === steps.length - 1);
      $('submit').classList.toggle('hidden', i !== steps.length - 1);
      if (i === 1) applyVorhaben();
      if (i === 3) calc();
      if (i > 0) f.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function valid(step) {
      for (const el of step.querySelectorAll('input,select,textarea')) {
        if (el.closest('.hidden') && el.closest('.hidden') !== step) continue;
        if (!el.checkValidity()) { el.reportValidity(); return false; }
      }
      return true;
    }

    f.querySelectorAll('input[name=vorhaben]').forEach((r) => r.addEventListener('change', () => show(1)));
    $('next').addEventListener('click', () => { if (valid(steps[cur])) show(cur + 1); });
    $('back').addEventListener('click', () => show(cur - 1));
    show(0);
  </script>
</Layout>
