---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Vielen Dank">
  <section class="mx-auto max-w-2xl px-4 py-24 text-center">
    <div class="text-6xl">✅</div>
    <h1 class="mt-4 text-3xl font-extrabold text-brand-900">Vielen Dank für Ihre Anfrage!</h1>
    <p class="mt-4 text-slate-600">Wir melden uns innerhalb von 1–2 Werktagen bei Ihnen, um einen kostenlosen Vor-Ort-Termin zu vereinbaren.</p>
    <a href="/" class="mt-8 inline-block rounded-full bg-brand-600 px-6 py-3 font-semibold text-white">Zur Startseite</a>
  </section>
</Layout>
