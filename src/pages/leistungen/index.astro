---
import Layout from '../../layouts/Layout.astro';
import { services } from '../../data/site';
---
<Layout title="Leistungen">
  <section class="mx-auto max-w-7xl px-4 py-16">
    <h1 class="text-4xl font-extrabold text-brand-900">Leistungen</h1>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <a href={`/leistungen/${s.slug}/`} class="rounded-2xl border border-slate-200 p-6 hover:border-brand-500 hover:shadow-lg transition">
          <div class="text-3xl">{s.icon}</div>
          <h2 class="mt-3 font-semibold text-lg">{s.title}</h2>
          <p class="mt-2 text-sm text-slate-600">{s.short}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
