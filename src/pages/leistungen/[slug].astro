---
import Layout from '../../layouts/Layout.astro';
import { services } from '../../data/site';
export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
---
<Layout title={s.title} description={s.short}>
  <section class="bg-brand-900 text-white">
    <div class="mx-auto max-w-7xl px-4 py-16">
      <div class="text-5xl">{s.icon}</div>
      <h1 class="mt-4 text-4xl font-extrabold">{s.title}</h1>
      <p class="mt-4 max-w-2xl text-brand-100 text-lg">{s.short}</p>
    </div>
  </section>
  <section class="mx-auto max-w-3xl px-4 py-12 prose">
    <p class="text-slate-600">Inhalt folgt: Hier kommen die Texte von der bisherigen Seite (überarbeitet) und Projektbilder hin.</p>
    <div class="mt-10 rounded-2xl bg-brand-50 p-8">
      {s.quote ? (
        <>
          <h2 class="text-xl font-bold text-brand-900">Was kostet das bei mir?</h2>
          <p class="mt-2 text-slate-600">Beantworten Sie ein paar Fragen und erhalten Sie eine unverbindliche Preisindikation.</p>
          <a href={`/preisanfrage/?typ=${s.quote}`} class="mt-4 inline-block rounded-full bg-accent-400 px-6 py-3 font-semibold text-brand-900 hover:bg-accent-500">Online-Preisanfrage</a>
        </>
      ) : (
        <>
          <h2 class="text-xl font-bold text-brand-900">Interesse?</h2>
          <a href="/kontakt/" class="mt-4 inline-block rounded-full bg-brand-600 px-6 py-3 font-semibold text-white hover:bg-brand-700">Kontakt aufnehmen</a>
        </>
      )}
    </div>
  </section>
</Layout>
